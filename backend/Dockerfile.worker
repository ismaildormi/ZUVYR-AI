# ZUVYR attachment-processing worker image.
# Kept separate from backend/Dockerfile so document tooling never bloats
# or expands the attack surface of the public API service.

FROM node:22-alpine AS deps
WORKDIR /app

COPY package.json ./
COPY package-lock.json* ./
RUN npm install --omit=dev --no-audit --no-fund

FROM node:22-alpine AS runtime
WORKDIR /app

# Worker-only document stack:
# - LibreOffice: isolated Office conversion to PDF
# - Poppler: PDF metadata, bounded text extraction, page rendering/splitting
# - Tesseract: OCR for scanned pages
# - Explicit language data and fonts: English, Arabic, French
RUN apk add --no-cache \
    tini \
    libreoffice-common \
    libreoffice-writer \
    libreoffice-calc \
    libreoffice-impress \
    poppler-utils \
    tesseract-ocr \
    tesseract-ocr-data-eng \
    tesseract-ocr-data-ara \
    tesseract-ocr-data-fra \
    font-dejavu \
    font-noto-arabic \
    ffmpeg \
  && soffice --version \
  && pdftotext -v 2>&1 | head -n 1 \
  && tesseract --version | head -n 1 \
  && ffmpeg -version | head -n 1 \
  && ffprobe -version | head -n 1 \
  && ffmpeg -y -hide_banner -loglevel error \
       -f lavfi -i color=c=black:s=64x64:r=10 \
       -f lavfi -i anullsrc=r=48000:cl=stereo \
       -t 0.4 -shortest -c:v libx264 -pix_fmt yuv420p -c:a aac \
       /tmp/zuvyr-pack069-source.mp4 \
  && ffmpeg -y -hide_banner -loglevel error \
       -i /tmp/zuvyr-pack069-source.mp4 \
       -c:v libx264 -pix_fmt yuv420p -c:a aac -movflags +faststart \
       /tmp/zuvyr-pack069-check.mp4 \
  && ffmpeg -y -hide_banner -loglevel error \
       -i /tmp/zuvyr-pack069-source.mp4 \
       -c:v libvpx-vp9 -crf 40 -b:v 0 -c:a libopus \
       /tmp/zuvyr-pack069-check.webm \
  && ffmpeg -y -hide_banner -loglevel error \
       -i /tmp/zuvyr-pack069-source.mp4 \
       -c:v libx264 -pix_fmt yuv420p -c:a aac \
       /tmp/zuvyr-pack069-check.mov \
  && ffprobe -v error -show_entries format=format_name,duration -of json \
       /tmp/zuvyr-pack069-check.mp4 | grep -q '"duration"' \
  && ffprobe -v error -show_entries format=format_name,duration -of json \
       /tmp/zuvyr-pack069-check.webm | grep -q '"duration"' \
  && ffprobe -v error -show_entries format=format_name,duration -of json \
       /tmp/zuvyr-pack069-check.mov | grep -q '"duration"' \
  && rm -f /tmp/zuvyr-pack069-source.mp4 \
       /tmp/zuvyr-pack069-check.mp4 \
       /tmp/zuvyr-pack069-check.webm \
       /tmp/zuvyr-pack069-check.mov

ENV NODE_ENV=production \
    HOME=/tmp/zuvyr-worker-home \
    ATTACHMENT_DOCUMENT_TOOLS_ENABLED=1 \
    ATTACHMENT_OCR_LANGUAGES=eng+ara+fra

COPY --from=deps --chown=node:node /app/node_modules ./node_modules
COPY --chown=node:node . .

RUN mkdir -p \
      /tmp/zuvyr-worker-home \
      /tmp/zuvyr-attachments \
  && chown -R node:node \
      /tmp/zuvyr-worker-home \
      /tmp/zuvyr-attachments

USER node

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "worker.js"]