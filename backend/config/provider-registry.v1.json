    "replicate": {
      "credentialEnvironment": [
        "REPLICATE_API_TOKEN"
      ],
      "regions": [
        "provider_managed"
      ],
      "quotaType": "provider_managed",
      "termsLicenseNotes": "Pack066 revalidated the official Replicate Wan 2.2 T2V Fast model page on 2026-09-19: commercial use is permitted; official pricing is $0.05/output video at 480p and $0.10/output video at 720p. Paid execution remains gated by PACK066_PAID_EXECUTION_ENABLED.",
      "adapter": "image.providers",
      "capabilities": [
        {
          "id": "image.generate",
          "verification": "verified_current",
          "cost": {
            "mode": "registry_verified_entry",
