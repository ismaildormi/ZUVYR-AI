{
  "schema_version": "zuvyr.user-outcome-pack-overlay.v1",
  "status": "CANONICAL_GLOBAL_OVERLAY",
  "date": "2026-09-17",
  "applies_to": {
    "from": "001",
    "to": "150",
    "future_packs": true
  },
  "roadmap_files": [
    "docs/zuvyr/ROADMAP_150.md",
    "docs/zuvyr/roadmap-150.json"
  ],
  "canonical_contract": "docs/zuvyr/USER_OUTCOME_ENGINE.md",
  "execution_appendix": "docs/zuvyr/PACK_EXECUTION_APPENDIX.md",
  "global_pack_requirements": {
    "mandatory_before_lock": true,
    "required_fields": [
      "user_value",
      "executable_user_actions",
      "money_opportunity_relevance",
      "money_opportunity_notes",
      "next_best_action",
      "suggestion_chips",
      "provenance_behavior",
      "personalization_behavior",
      "hard_stop_impact",
      "outcome_tests"
    ],
    "lock_questions": [
      "How does this capability concretely improve the user's real-world position?",
      "What can ZUVYR execute for the user here rather than merely explain?",
      "What contextual Next Best Action should ZUVYR suggest after the result?"
    ],
    "suggestion_loop": {
      "required_when_user_facing": true,
      "tap_must_rehydrate_current_context": true,
      "static_generic_chips_forbidden": true,
      "inputs": [
        "current_conversation",
        "immediately_preceding_result",
        "active_user_goal",
        "authorized_memory_context",
        "available_tools_permissions",
        "unresolved_blockers",
        "known_costs_risks",
        "current_task_state"
      ],
      "cycle": [
        "CONTEXT",
        "ANSWER_OR_ACTION",
        "RESULT",
        "RE_EVALUATE",
        "NEXT_BEST_ACTION",
        "USER_TAP",
        "CONTEXTUAL_EXECUTION",
        "NEW_RESULT"
      ]
    },
    "money_opportunity_scan": "contextual_and_proactive",
    "provenance_labels": [
      "VERIFIED",
      "LIKELY",
      "COMMUNITY",
      "UNVERIFIED",
      "SPECULATIVE"
    ],
    "fabrication_forbidden": true,
    "formal_documentation_required_for_mention": false,
    "hard_stop_scope": [
      "killing",
      "explosives",
      "serious physical injury",
      "theft",
      "fraud",
      "coercion",
      "destructive cyber abuse"
    ],
    "preserve_safe_non_operational_content": true
  },
  "classes": {
    "economics_billing_limits": {
      "packs": "001-020",
      "requirement": "Expose cost/value impact, cheaper legitimate alternatives when useful, and the next financial action."
    },
    "providers_models_router_kernel": {
      "packs": "021-040",
      "requirement": "Route for successful user outcome and total successful-task cost; preserve Answer/Execute/Next-Best-Action behavior across providers."
    },
    "shared_ux_context_chat_research": {
      "packs": "041-060",
      "requirement": "Implement contextual suggestion loops, provenance labels, user-goal state, and cross-turn Next Best Action continuity."
    },
    "media": {
      "packs": "061-074",
      "requirement": "After creation, suggest the best meaningful follow-up such as edit, reuse, export, publish preparation, or monetization when contextually relevant."
    },
    "code_studio": {
      "packs": "075-080",
      "requirement": "Move from explanation to build/test/fix/export workflows and derive the next development action from actual workspace/build state."
    },
    "browser_ip_automation_connectors": {
      "packs": "081-090",
      "requirement": "Execute authorized real-world actions, verify outcomes, reconcile uncertain side effects, and continue with the next useful action."
    },
    "manager_plans_learning_hardening": {
      "packs": "091-100",
      "requirement": "Expose and test outcome KPIs, unnecessary refusals, opportunity quality, suggestion quality, execution success, and cost per successful task."
    },
    "integration_production_qualification": {
      "packs": "101-150",
      "requirement": "Prove the contract survives cross-surface handoff, interruption, recovery, scale, privacy, billing, learning, and final V1 acceptance."
    }
  },
