{
  "schemaVersion": 1,
  "pack": 60,
  "mode": "context_graph",
  "limits": {
    "nameChars": 120,
    "descriptionChars": 2000,
    "contentChars": 200000,
    "projectItems": 200,
    "workflowSteps": 20,
    "templateVariables": 50,
    "scheduleTitleChars": 120,
    "permissionScopes": 12,
    "documentFormats": 4,
    "documentSourceRecords": 30,
    "spreadsheetSheets": 20,
    "spreadsheetRowsPerSheet": 5000,
    "spreadsheetColumns": 100,
    "spreadsheetTotalCells": 100000,
    "presentationSlides": 60,
    "presentationLinesPerSlide": 24,
    "researchCheckpointSourceRecords": 30,
    "researchCheckpointTextChars": 120000
  },
  "itemKinds": [
    "chat",
    "file",
    "image",
    "video",
    "audio",
    "code",
    "document",
    "spreadsheet",
    "presentation",
    "task"
  ],
  "creationKinds": [
    "document",
    "spreadsheet",
    "presentation"
  ],
  "workflowCapabilities": [
    "chat",
    "image",
    "video",
    "audio",
    "code",
    "research",
    "document",
    "spreadsheet",
    "presentation",
    "export"
  ],
  "foundations": {
    "library": true,
    "projects": true,
    "documents": true,
    "spreadsheets": true,
    "presentations": true,
    "templates": true,
    "scheduledTasks": true,
    "plugins": true,
    "googleDrive": true,
    "workflows": true,
    "memory": true,
    "contextGraph": true,
    "researchArtifactCheckpoint": true
  },
  "execution": {
    "workspaceWritesEnabled": true,
    "scheduledExecutionEnabled": false,
    "workflowExecutionEnabled": false,
    "pluginInstallEnabled": false,
    "pluginRuntimeEnabled": false,
    "driveOAuthEnabled": false,
    "driveReadEnabled": false,
    "driveWriteEnabled": false,
    "externalExportsEnabled": false,
    "automaticPublishingEnabled": false
  },
  "security": {
    "wildcardScopesAllowed": false,
    "explicitConsentRequired": true,
    "externalWriteConfirmationRequired": true,
    "oauthTokensStoredInWorkspaceRows": false,
    "templateScriptsAllowed": false,
    "spreadsheetFormulaExecutionAllowed": false,
    "minimumScheduleIntervalMinutes": 60,
    "maximumScheduleHorizonDays": 366
  },
  "integrations": {
    "google_drive": {
      "status": "blocked_no_oauth_security_review",
      "allowedScopes": [
        "drive.file.read",
        "drive.file.write",
        "drive.export"
      ],
      "enabled": false
    },
    "plugins": {
      "status": "blocked_no_marketplace_security_review",
      "allowedScopes": [
        "workspace.items.read",
        "workspace.items.write",
        "projects.read",
        "projects.write",
        "exports.create"
      ],
      "enabled": false
    }
  },
  "documentFormats": [
    "docx",
    "pdf",
    "txt",
    "md"
  ],
  "documentTemplates": {
    "builtin": true,
    "saved": true,
    "scriptsAllowed": false,
    "communityPublishingEnabled": false
  },
  "spreadsheetFormats": [
    "xlsx",
    "csv"
  ],
  "presentationFormats": [
    "pptx"
  ],
  "officeArtifactStorage": {
    "canonicalKind": "document",
    "metadataDiscriminator": "officeArtifactKind",
    "providerCalls": 0,
    "generationCredits": 0
  },
  "researchArtifactCheckpoint": {
    "enabled": true,
    "outputs": [
      "document",
      "spreadsheet",
      "presentation"
    ],
    "requiresVerifiedSourceRecords": true,
    "conversionProviderCalls": 0,
    "conversionCredits": 0,
    "upstreamResearchBillingUnaffected": true,
    "downloadUsesLibrarySignedUrl": true,
    "cancellation": "pre_persist_only"
  }
}
