      ],
      "quotaType": "provider_managed",
      "termsLicenseNotes": "Google/Gemini remains blocked until M10 verifies the selected launch model, terms and cost source.",
      "adapter": "src/modules/ai/providers/index.js",
      "capabilities": [
        {
          "id": "chat",
          "verification": "registered_unverified",
          "cost": {
            "mode": "registry_verified_entry",
