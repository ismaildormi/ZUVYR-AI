{
  "schema_version": "1.1",
  "effective_date": "2026-09-23",
  "status": "CANONICAL_EXECUTION_POLICY_OVERRIDE",
  "applies_to": "PACK001..PACK150_AND_FUTURE",
  "completed_packs_are_immutable": false,
  "renumber_historical_packs": false,
  "delete_or_rewrite_prior_receipts": false,
  "redo_unchanged_work_for_ceremony": false,
  "older_pack_improvement_can_skip_active_gate": false,
  "clean_claim_requires_zero_known_actionable_internal_findings": true,
  "adjacent_discovered_actionable_findings_must_be_resolved": true,
  "external_blockers_must_be_explicit_and_evidenced": true,
  "informational_findings_may_be_accepted_only_with_documented_rationale": true,
  "revisit_allowed_when": [
    "fresh_evidence_conflict",
    "security_or_authorization_defect",
    "privacy_billing_reliability_data_integrity_accessibility_performance_recovery_defect",
    "missing_commit_push_deploy_or_production_verification",
    "new_additive_v1_requirement",
    "new_product_idea_materially_improves_existing_pack",
    "deferred_gate_now_truthfully_executable",
    "better_architecture_or_cost_quality_outcome",
    "stale_receipt_or_state"
  ],
  "allowed_change_labels": [
    "FIX",
    "HARDENING",
    "RECONCILIATION",
    "ADDITIVE_AMENDMENT"
  ],
  "required_loop": [
    "ground_fresh_state",
    "preserve_prior_evidence",
    "implement_narrow_improvement",
    "focused_test",
    "regression",
    "diff_review",
    "commit",
    "push",
    "deploy_changed_runtime_surfaces",
    "production_verify",
    "new_dated_receipt",
    "reconcile_canonical_state"
  ],
  "clean_claim_rule": "Never claim CLEAN, LOCKED_VERIFIED, final, finished, complete, or all-green while any known actionable internal finding remains unresolved. Resolve safe actionable findings discovered in or adjacent to the task before closure. Only genuinely external blockers may remain, and each must be named with fresh evidence, exact owner, and exact required action.",
  "external_gate_rule": "Record truthful blockers; never fabricate success or spend money without explicit authority.",
  "quality_target": "Higher than minimum requirement while preserving safety, permissions, billing invariants and existing verified behavior."
}
