        "provider_managed"
      ],
      "quotaType": "provider_managed",
      "termsLicenseNotes": "Direct Anthropic remains blocked until M10 verifies current terms, account authorization and exact cost source.",
      "adapter": "src/modules/ai/providers/index.js",
      "capabilities": [
        {
          "id": "chat",
          "verification": "registered_unverified",
          "cost": {
            "mode": "registry_verified_entry",
            "authority": "backend/config/cost-registry.v1.json"
          }
        },
        {
          "id": "code",
          "verification": "registered_unverified",
          "cost": {
            "mode": "registry_verified_entry",
            "authority": "backend/config/cost-registry.v1.json"
          }
        }
      ]
    },
    "openai": {
      "credentialEnvironment": [
        "OPENAI_API_KEY"
      ],
      "regions": [
        "provider_managed"
      ],
      "quotaType": "provider_managed",
      "termsLicenseNotes": "Direct OpenAI remains blocked until M10 verifies current terms, account authorization and exact cost source.",
      "adapter": "src/modules/ai/providers/index.js",
      "capabilities": [
        {
          "id": "chat",
          "verification": "registered_unverified",
          "cost": {
