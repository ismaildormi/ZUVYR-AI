    "local": {
      "credentialEnvironment": [],
      "connectionEnvironment": [
        "LOCAL_MODEL_BASE_URL"
      ],
      "regions": [
        "local_runtime"
      ],
      "quotaType": "local_runtime",
      "termsLicenseNotes": "Local models require model-specific license and compute-cost verification before launch authorization.",
      "adapter": "src/modules/ai/providers/index.js",
      "capabilities": [
        {
          "id": "chat",
          "verification": "registered_unverified",
          "cost": {
            "mode": "unverified",
            "authority": "backend/config/cost-registry.v1.json"
          }
        }
      ]
    },
    "fal": {
      "credentialEnvironment": [
        "FAL_KEY",
        "HF_TOKEN"
      ],
      "regions": [
        "provider_managed"
      ],
      "quotaType": "provider_managed",
      "termsLicenseNotes": "Pack061 ordinary FLUX Schnell may route through HF_TOKEN or direct FAL_KEY. Pack062 FLUX Kontext multi requires direct FAL_KEY because Hugging Face Inference Providers returned model-not-supported for provider fal-ai on 2026-09-18. Pack063 adds direct-Fal source edit, Qwen inpaint and directional outpaint adapters. Paid Pack063 execution remains disabled by default; inpaint/outpaint variable-MP billing activation is fail-closed. Pack064 Phase01 adds repository adapters for BiRefNet v2 background removal, Flux Vision Upscaler and Image Apps v2 relighting. No operation is exposed or externally executed until Phase02 completes pricing/persistence/runtime wiring.",
      "adapter": "image.providers",
      "capabilities": [
        {
          "id": "image.generate",
          "verification": "verified_repository",
          "cost": {
            "mode": "registry_verified_entry",
            "authority": "backend/config/cost-registry.v1.json",
            "entryId": "fal-image-generation"
          },
          "model": "fal-ai/flux/schnell"
        },
        {
          "id": "image.reference_variation",
          "verification": "verified_repository",
          "cost": {
            "mode": "registry_verified_entry",
            "authority": "backend/config/cost-registry.v1.json",
            "entryId": "fal-kontext-reference-variation"
          },
          "model": "fal-ai/flux-pro/kontext/multi",
          "requiredCredentialEnvironment": [
            "FAL_KEY"
          ],
          "routing": {
            "mode": "direct_fal",
            "hfInferenceProvidersSupported": false,
            "hfFailureEvidence": "2026-09-18 HTTP 400: Model not supported by provider fal-ai",
            "authority": "https://fal.ai/models/fal-ai/flux-pro/kontext/multi/api"
          },
          "routeVerification": "direct_fal_repository_verified"
        },
        {
          "id": "image.edit",
          "verification": "verified_repository",
          "cost": {
            "mode": "registry_verified_entry",
            "authority": "backend/config/cost-registry.v1.json",
            "entryId": "fal-kontext-image-edit"
          },
          "model": "fal-ai/flux-pro/kontext",
          "requiredCredentialEnvironment": [
            "FAL_KEY"
          ],
          "routing": {
            "mode": "direct_fal",
            "authority": "https://fal.ai/models/fal-ai/flux-pro/kontext/api"
          }
        },
        {
          "id": "image.inpaint",
          "verification": "verified_repository",
          "cost": {
            "mode": "registry_verified_entry",
            "authority": "backend/config/cost-registry.v1.json",
            "entryId": "fal-qwen-image-inpaint",
            "requiredEnvironment": {
              "name": "PACK063_ONE_MP_BILLING_CONFIRMED",
              "value": "true"
            }
          },
          "model": "fal-ai/qwen-image-edit/inpaint",
          "requiredCredentialEnvironment": [
            "FAL_KEY"
          ],
          "routing": {
            "mode": "direct_fal",
            "authority": "https://fal.ai/models/fal-ai/qwen-image-edit/inpaint/api"
          }
        },
        {
          "id": "image.outpaint",
          "verification": "verified_repository",
          "cost": {
            "mode": "registry_verified_entry",
            "authority": "backend/config/cost-registry.v1.json",
            "entryId": "fal-image-apps-v2-outpaint",
            "requiredEnvironment": {
              "name": "PACK063_ONE_MP_BILLING_CONFIRMED",
              "value": "true"
            }
          },
          "model": "fal-ai/image-apps-v2/outpaint",
          "requiredCredentialEnvironment": [
            "FAL_KEY"
          ],
          "routing": {
            "mode": "direct_fal",
            "authority": "https://fal.ai/models/fal-ai/image-apps-v2/outpaint/api"
          }
        },
        {
          "id": "image.remove_background",
          "verification": "verified_repository",
          "cost": {
            "mode": "registry_verified_entry",
            "authority": "backend/config/cost-registry.v1.json",
            "entryId": "fal-birefnet-v2-background-removal",
            "requiredEnvironment": {
              "name": "PACK064_EXTERNAL_EXECUTION_ENABLED",
              "value": "true"
            }
          },
          "model": "fal-ai/birefnet/v2",
          "requiredCredentialEnvironment": [
            "FAL_KEY"
          ],
          "routing": {
            "mode": "direct_fal",
            "authority": "https://fal.ai/models/fal-ai/birefnet/v2/api"
          }
        },
        {
          "id": "image.upscale",
          "verification": "repository_adapter_verified_pricing_activation_pending",
          "cost": {
            "mode": "registry_verified_entry",
            "authority": "backend/config/cost-registry.v1.json",
            "entryId": "fal-flux-vision-upscaler"
          },
          "model": "fal-ai/flux-vision-upscaler",
          "requiredCredentialEnvironment": [
            "FAL_KEY"
          ],
          "routing": {
            "mode": "direct_fal",
            "authority": "https://fal.ai/models/fal-ai/flux-vision-upscaler/api"
          }
        },
        {
          "id": "image.relight",
          "verification": "verified_repository",
          "cost": {
            "mode": "registry_verified_entry",
            "authority": "backend/config/cost-registry.v1.json",
            "entryId": "fal-image-apps-v2-relighting",
            "requiredEnvironment": {
              "name": "PACK064_EXTERNAL_EXECUTION_ENABLED",
              "value": "true"
            }
          },
          "model": "fal-ai/image-apps-v2/relighting",
          "requiredCredentialEnvironment": [
            "FAL_KEY"
          ],
          "routing": {
            "mode": "direct_fal",
            "authority": "https://fal.ai/models/fal-ai/image-apps-v2/relighting/api"
          }
        }
      ]
