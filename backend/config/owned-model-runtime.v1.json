  "teacherGateway": {
    "rawProviderSystemPromptsAllowed": false,
    "providerWeightsAllowed": false,
    "customerPrivateContentWithoutRightsAllowed": false,
    "requiresContractOrLicensePermission": true,
    "requiresCanonicalContentVersion": true,
    "requiresPack094Rights": true,
    "requiresTrainingConsent": true,
    "requiresPrivacyProcessed": true,
    "requiresVerifiedProvenance": true,
    "admissionAuthority": "admit_zuvyr_training_candidate_pack094",
