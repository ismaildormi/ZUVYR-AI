{
  "version": "pack-086.device-agent.v1",
  "protocolVersion": 1,
  "status": "pairing_session_engineering_ready",
  "bind": {
    "host": "127.0.0.1",
    "port": 47831,
    "allowedHostnames": [
      "127.0.0.1",
      "localhost"
    ],
    "browserOriginsAllowed": false,
    "requestBodyMaxBytes": 16384,
    "requestTimeoutMs": 5000
  },
  "identity": {
    "algorithm": "Ed25519",
    "fingerprint": "sha256-spki",
    "privateFileMode": "0600",
    "stateDirectoryMode": "0700",
    "tokenBytes": 32
  },
  "execution": {
    "pairingEnabled": true,
    "computerControlEnabled": false,
    "screenCapture": false,
    "pointerControl": false,
    "keyboardControl": false,
    "applicationControl": false,
    "filesystemControl": false,
    "shellControl": false,
    "rawIpTrust": false
  },
  "update": {
    "enabled": false,
    "signatureAlgorithm": "Ed25519",
    "releasePublicKeyPem": null,
    "allowedHosts": [],
    "maxArtifactBytes": 134217728
  },
  "install": {
    "scope": "user",
    "requiresAdmin": false,
    "autoStartEnabledByDefault": false,
    "preserveIdentityOnUninstall": true
  },
  "externalGate": null,
  "session": {
    "transport": "https_only",
    "proofAlgorithm": "Ed25519",
    "tokenStorage": "local_private_file",
    "tokenTtlSeconds": 3600,
    "allowedScopes": [
      "heartbeat"
    ],
    "monotonicCounterRequired": true,
    "tokenStoredServerSide": false,
    "rawIpTrust": false
  }
}
