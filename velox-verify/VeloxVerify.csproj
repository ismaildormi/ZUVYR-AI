<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>VeloxVerify</AssemblyName>
    <RootNamespace>VeloxVerify</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The Unity stubs are verification-only and must not be treated as warnings. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="UnityEngineStubs.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="../Assets/_Game/Scripts/**/*.cs" />
  </ItemGroup>

</Project>
